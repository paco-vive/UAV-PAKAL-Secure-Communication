- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass wavelet_edge_detector(gr.sync_block):\n\
      \    def __init__(self, vector_length=1024, scale=10):\n        gr.sync_block.__init__(self,\
      \ name=\"Wavelet Edge Detector\",\n            in_sig=[(np.float32, vector_length)],\n\
      \            out_sig=[(np.float32, vector_length)])\n        self.vector_length\
      \ = vector_length\n        self.scale = scale\n\n    def work(self, input_items,\
      \ output_items):\n        # input_items[0][0] es tu espectro S(n)\n        s_n\
      \ = input_items[0][0]\n        \n        # Creamos la Wavelet B-spline c\xFA\
      bica (simplificada para detecci\xF3n de bordes)\n        # Una escala grande\
      \ (j=10) significa un filtro de suavizado muy ancho\n        # que resalta las\
      \ transiciones lentas (banda ancha)\n        \n        # Simulamos la derivada\
      \ de una Gaussiana (comportamiento similar a spline en bordes)\n        points\
      \ = np.arange(-self.vector_length//2, self.vector_length//2)\n        wavelet\
      \ = -points * np.exp(-(points**2) / (2 * (self.scale**2)))\n        \n     \
      \   # Convoluci\xF3n para obtener los coeficientes wavelet d_j(n)\n        #\
      \ Esto es lo que ves en la Figura 6(b) del paper\n        coeffs = np.convolve(s_n,\
      \ wavelet, mode='same')\n        \n        output_items[0][0][:] = coeffs\n\
      \        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '10'
    vector_length: '1024'
  states:
    _io_cache: ('Wavelet Edge Detector', 'wavelet_edge_detector', [('vector_length',
      '1024'), ('scale', '10')], [('0', 'float', 1024)], [('0', 'float', 1024)], '',
      ['scale', 'vector_length'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 164.0]
    rotation: 0
    state: true
