- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, samp_rate=10e6, hop_rate=10, hop_spacing=500e3, pattern=0):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Freq\
      \ Hopper',\n            in_sig=None,\n            out_sig=[np.complex64]\n \
      \       )\n        self.samp_rate = samp_rate\n        self._hop_rate = hop_rate\n\
      \        self._hop_spacing = hop_spacing\n        self._pattern = pattern\n\
      \        self.phase = 0.0\n        self.sample_count = 0\n        self.current_hop\
      \ = 0\n        self._build_table()\n        self._update_samples_per_hop()\n\
      \n    def _build_table(self):\n        n = 11  # n\xFAmero de frecuencias en\
      \ la tabla\n        spacing = self._hop_spacing\n        \n        if self._pattern\
      \ == 0:\n            # Escalera izquierda a derecha (lo que tienes ahora)\n\
      \            self.hop_table = [i * spacing - 5 * spacing for i in range(n)]\n\
      \        elif self._pattern == 1:\n            # Escalera derecha a izquierda\n\
      \            self.hop_table = [5 * spacing - i * spacing for i in range(n)]\n\
      \        elif self._pattern == 2:\n            # Aleatorio (m\xE1s realista,\
      \ como Skylink real)\n            rng = np.random.default_rng(42)\n        \
      \    self.hop_table = list(rng.permutation(\n                [i * spacing -\
      \ 5 * spacing for i in range(n)]\n            ))\n        elif self._pattern\
      \ == 3:\n            # Zigzag: izquierda-derecha alternando\n            base\
      \ = [i * spacing - 5 * spacing for i in range(n)]\n            self.hop_table\
      \ = base[::2] + base[1::2]\n        elif self._pattern == 4:\n            #\
      \ Solo extremos: salta entre borde izquierdo y derecho\n            self.hop_table\
      \ = [-5*spacing, 5*spacing] * 5\n\n    def _update_samples_per_hop(self):\n\
      \        self.samples_per_hop = max(1, int(self.samp_rate / self._hop_rate))\n\
      \n    # Setters para actualizar en caliente desde QT Range\n    @property\n\
      \    def hop_rate(self):\n        return self._hop_rate\n    @hop_rate.setter\n\
      \    def hop_rate(self, val):\n        self._hop_rate = val\n        self._update_samples_per_hop()\n\
      \n    @property\n    def hop_spacing(self):\n        return self._hop_spacing\n\
      \    @hop_spacing.setter\n    def hop_spacing(self, val):\n        self._hop_spacing\
      \ = val\n        self._build_table()\n\n    @property\n    def pattern(self):\n\
      \        return self._pattern\n    @pattern.setter\n    def pattern(self, val):\n\
      \        self._pattern = int(val)\n        self.current_hop = 0\n        self._build_table()\n\
      \n    def work(self, input_items, output_items):\n        out = output_items[0]\n\
      \        n = len(out)\n        for i in range(n):\n            if self.sample_count\
      \ >= self.samples_per_hop:\n                self.current_hop = (self.current_hop\
      \ + 1) % len(self.hop_table)\n                self.sample_count = 0\n      \
      \      freq = self.hop_table[self.current_hop]\n            self.phase += 2\
      \ * np.pi * freq / self.samp_rate\n            self.phase %= 2 * np.pi\n   \
      \         out[i] = np.exp(1j * self.phase).astype(np.complex64)\n          \
      \  self.sample_count += 1\n        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    hop_rate: hop_rate
    hop_spacing: hop_spacing
    maxoutbuf: '0'
    minoutbuf: '0'
    pattern: pattern
    samp_rate: samp_rate
  states:
    _io_cache: ('Freq Hopper', 'blk', [('samp_rate', '10000000.0'), ('hop_rate', '10'),
      ('hop_spacing', '500000.0'), ('pattern', '0')], [], [('0', 'complex', 1)], '',
      ['hop_rate', 'hop_spacing', 'pattern', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 276.0]
    rotation: 0
    state: true
