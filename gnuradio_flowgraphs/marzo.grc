- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, samp_rate=10e6, hop_rate=50):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Freq Hopper',\n            in_sig=None,\n\
      \            out_sig=[np.complex64]\n        )\n        self.samp_rate = samp_rate\n\
      \        self.hop_rate = hop_rate  # saltos por segundo\n        \n        #\
      \ Frecuencias de salto t\xEDpicas del Skylink en 2.4 GHz\n        # Offsets\
      \ respecto al centro (en Hz)\n        self.hop_table = [\n            -3e6,\
      \ -2e6, -1.5e6, -1e6, -0.5e6,\n             0,\n             0.5e6, 1e6, 1.5e6,\
      \ 2e6, 3e6\n        ]\n        \n        self.current_hop = 0\n        self.samples_per_hop\
      \ = int(samp_rate / hop_rate)\n        self.sample_count = 0\n        self.phase\
      \ = 0.0\n\n    def work(self, input_items, output_items):\n        out = output_items[0]\n\
      \        n = len(out)\n        \n        for i in range(n):\n            # Cambiar\
      \ frecuencia cuando se cumple el per\xEDodo\n            if self.sample_count\
      \ >= self.samples_per_hop:\n                self.current_hop = (self.current_hop\
      \ + 1) % len(self.hop_table)\n                self.sample_count = 0\n      \
      \      \n            freq = self.hop_table[self.current_hop]\n            self.phase\
      \ += 2 * np.pi * freq / self.samp_rate\n            self.phase %= 2 * np.pi\n\
      \            out[i] = np.exp(1j * self.phase).astype(np.complex64)\n       \
      \     self.sample_count += 1\n        \n        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    hop_rate: '10'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    _io_cache: ('Freq Hopper', 'blk', [('samp_rate', '10000000.0'), ('hop_rate', '50')],
      [], [('0', 'complex', 1)], '', ['hop_rate', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 276.0]
    rotation: 0
    state: true
